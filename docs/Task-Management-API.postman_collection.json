{
  "info": {
    "name": "Task Management API",
    "description": "API requests for the Task Management System assessment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "taskId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Get All Tasks",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/tasks"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "pm.test('Response contains tasks array', () => pm.expect(pm.response.json().data).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Task by ID",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/tasks/{{taskId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200 or 404', () => pm.expect([200, 404]).to.include(pm.response.code));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Task",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Prepare assessment submission\",\n  \"description\": \"Test the task management API and prepare documentation.\",\n  \"status\": \"pending\",\n  \"priority\": \"high\",\n  \"dueDate\": \"2026-10-15\"\n}"
        },
        "url": "{{baseUrl}}/api/tasks"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 201', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) {",
              "  const task = pm.response.json().data;",
              "  pm.expect(task.id).to.be.a('string');",
              "  pm.collectionVariables.set('taskId', task.id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Update Task",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Updated assessment task\",\n  \"description\": \"Updated task details.\",\n  \"status\": \"in_progress\",\n  \"priority\": \"medium\",\n  \"dueDate\": \"2026-10-20\"\n}"
        },
        "url": "{{baseUrl}}/api/tasks/{{taskId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200 or 404', () => pm.expect([200, 404]).to.include(pm.response.code));"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete Task",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/tasks/{{taskId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200 or 404', () => pm.expect([200, 404]).to.include(pm.response.code));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Task - Invalid Payload",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"\",\n  \"description\": \"\",\n  \"status\": \"invalid\",\n  \"priority\": \"urgent\"\n}"
        },
        "url": "{{baseUrl}}/api/tasks"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 400 for invalid input', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    }
  ]
}
